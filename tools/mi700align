#!/usr/bin/env python3
"""印字位置の確認パターンを生成する (PostScript を標準出力へ)

トラクタを動かしたときや印字位置が怪しいときに、用紙1枚で
「ページの原点が用紙端から何mmの位置に来ているか」を実測できる。

目盛りはすべて**ページ座標**(ページ原点からのmm)。基準線は
**印字可能範囲の角**に引く。ページ原点そのものは印字可能範囲の外に
あることが多く(カット紙なら左1.6mm・上8.7mm)、そこに線を引いても
ラスタライズの時点で切り捨てられて出てこないため。

  用紙の端から目盛りまでを測り、その目盛りの数字を引けばページ原点が出る。

  mi700align Cont10x45 | pdf2mi700 --source rear --direction uni > /tmp/a.prn
  mi700align --size 210x297 | pdf2mi700 --source cut --direction uni > /tmp/a.prn
"""
import os, sys

CONF = ["/usr/local/share/mi700/forms.conf",
        os.path.expanduser("~/Developer/mi700/forms.conf")]


def forms():
    out = {}
    for c in CONF:
        if not os.path.exists(c):
            continue
        for line in open(c, encoding="utf-8"):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            f = line.split("\t")
            if len(f) < 4:
                continue
            # 5〜8列目 = ページ座標での印字不可領域 左/右/上/下 mm (省略可)
            def col(k):
                return float(f[k]) if len(f) > k and f[k].strip() else 0.0
            out.setdefault(f[0], (f[1], float(f[2]), float(f[3]),
                                  col(4), col(5), col(6), col(7)))
    return out


def main():
    F = forms()
    args = sys.argv[1:]
    if not args:
        print("用紙を指定してください。登録済み:", file=sys.stderr)
        for k, v in sorted(F.items()):
            print(f"  {k:<12} {v[0]}  {v[1]} x {v[2]} mm", file=sys.stderr)
        print("  または --size 幅x高さ (mm)", file=sys.stderr)
        return 1
    if args[0] == "--size":
        w, h = (float(v) for v in args[1].lower().split("x"))
        lm = rm = tm = bm = 0.0
        name = f"{w:g}x{h:g}mm"
    elif args[0] in F:
        _, w, h, lm, rm, tm, bm = F[args[0]]
        # PostScript の標準フォントは日本語を出せないので ASCII のキー名を使う
        name = args[0]
    else:
        print(f"未登録の用紙: {args[0]}", file=sys.stderr)
        return 1

    # 印字可能範囲(ページ座標)。ここから外に引いた線は出てこない
    x0, y0, x1, y1 = lm, tm, w - rm, h - bm
    if x1 - x0 < 20 or y1 - y0 < 20:
        print(f"印字可能範囲が狭すぎます: {x1-x0:g} x {y1-y0:g} mm", file=sys.stderr)
        return 1

    # 目盛りはページ座標の10mm刻み。印字可能範囲に入るものだけ描く
    xs = [t for t in range(0, int(w) + 1, 10) if x0 <= t <= x1 - 2]
    ys = [t for t in range(0, int(h) + 1, 10) if y0 <= t <= y1 - 2]
    if not xs or not ys:
        print("目盛りを置ける余地がありません", file=sys.stderr)
        return 1

    P = 72 / 25.4
    def mm(v): return v * P

    o = [f"""%!PS-Adobe-3.0
<< /PageSize [{w*P:.0f} {h*P:.0f}] >> setpagedevice
/mm {{ {P:.6f} mul }} def
/T {{ {h*P:.4f} exch sub }} def
/L {{ moveto lineto stroke }} def
/Helvetica findfont 8 scalefont setfont"""]

    # 基準線 = 印字可能範囲の左辺と上辺。必ず印字される
    o.append("0.4 mm setlinewidth")
    o.append(f"{x0:g} mm {y0:g} mm T {x0:g} mm {ys[-1]:g} mm T L")
    o.append(f"{x0:g} mm {y0:g} mm T {xs[-1]:g} mm {y0:g} mm T L")

    # 角に印を付けて、それがページ座標で何mmかを書く
    o.append("/Helvetica-Bold findfont 7 scalefont setfont")
    o.append(f"{x0+1.5:g} mm {y0+5:g} mm T moveto "
             f"(PRINTABLE TOP-LEFT = page \\({lm:g}, {tm:g}\\)mm) show")

    # 目盛り(ページ座標)。5本ごとに長くする
    o.append("0.3 mm setlinewidth")
    for t in xs:
        o.append(f"{t:g} mm {y0:g} mm T {t:g} mm {y0 + (6 if t % 50 == 0 else 3):g} mm T L")
    for t in ys:
        o.append(f"{x0:g} mm {t:g} mm T {x0 + (6 if t % 50 == 0 else 3):g} mm {t:g} mm T L")

    # 数字。最初の1本は必ず、あとは50mmごと
    o.append("/Helvetica findfont 7 scalefont setfont")
    for t in xs:
        if t == xs[0] or t % 50 == 0:
            o.append(f"{t:g} mm 1 add {y0+10:g} mm T moveto ({t:g}) show")
    for t in ys:
        if t == ys[0] or t % 50 == 0:
            o.append(f"{x0+8:g} mm {t:g} mm T 2 sub moveto ({t:g}) show")

    # 使い方。印字可能範囲の中に置く
    ty = y0 + (y1 - y0) / 2
    tx = x0 + 15
    o.append("/Helvetica-Bold findfont 9 scalefont setfont")
    o.append(f"{tx:g} mm {ty:g} mm T moveto (MI700XX ALIGN CHECK) show")
    o.append("/Helvetica findfont 8 scalefont setfont")
    for i, s in enumerate([
        f"{name}  {w:g} x {h:g}mm   margins L{lm:g} R{rm:g} T{tm:g} B{bm:g} mm",
        "ticks are PAGE coordinates in mm from the page origin",
        "to locate the page origin: measure from the paper edge to any tick,",
        "then subtract that tick number.",
    ]):
        o.append(f"{tx:g} mm {ty + 6 + i*5:g} mm T moveto ({s}) show")
    o.append("showpage")
    print("\n".join(o))
    return 0


if __name__ == "__main__":
    sys.exit(main())
