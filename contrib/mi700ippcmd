#!/bin/bash
# ippeveprinter から1ドキュメントごとに呼ばれる変換コマンド
#
#   driver/mkippattr.py > mi700.conf
#   ippeveprinter -D socket://<IP>:9100 -c $PWD/contrib/mi700ippcmd \
#                 -a mi700.conf -r _print,_universal "MultiImpact 700XX"
#
# -r _print,_universal と URF の広告がそろわないと、macOS のシステム設定は
# AirPrint のプリンタとして扱わず、ドライバなしでは追加できない。
#
# -a と -f は同時に指定できない(Usage を出して止まる)。受け付ける形式は
# 属性ファイルの document-format-supported に書いてある。
#
# PWG Raster は CUPS Raster v2 と同じ容器、URF はフィルタに読み込みを足してある。
# 印刷可能データは stdout へ(ippeveprinter が -D のデバイスへ送る)。
# stderr の DEBUG:/INFO:/STATE: は CUPS フィルタと同じ作法で解釈される。
set -u
FILTER="${MI700_FILTER:-/usr/local/libexec/cups/filter/rastertomi700}"   # 開発中は差し替え可

SRC="${1:-}"
[ -n "$SRC" ] && [ -r "$SRC" ] || SRC=/dev/stdin

# PWG Raster と URF はどちらも rastertomi700 が直接読める。
#   lpadmin -m everywhere で追加した Mac → PWG Raster
#   システム設定から追加した Mac(AirPrint 扱い) → URF
case "${CONTENT_TYPE:-image/pwg-raster}" in
  image/pwg-raster|image/urf) ;;
  *) echo "ERROR: $CONTENT_TYPE は扱えません (image/pwg-raster と image/urf のみ)" >&2; exit 1 ;;
esac

# 給紙口。macOS は media-source を単独ではなく media-col の中に入れて送ってくる
#   IPP_MEDIA_COL={media-source=rear}
# macOS は IPP 標準のキーワードしか取り込まないので、標準名に割り当ててある
#   main → シートフィーダ  manual → シートガイド
#   rear → リアトラクタ    bottom → フロントトラクタ
src="${IPP_MEDIA_SOURCE:-}"
if [ -z "$src" ]; then
  src=$(printf '%s' "${IPP_MEDIA_COL:-}" | sed -n 's/.*media-source=\([a-z0-9-]*\).*/\1/p')
fi
case "$src" in
  main|auto|"") slot=feeder ;;
  manual)       slot=guide ;;
  rear)         slot=reartractor ;;
  bottom)       slot=fronttractor ;;
  *)            slot=feeder
                echo "WARNING: 未知の給紙口 $src をシートフィーダとして扱います" >&2 ;;
esac

opt="InputSlot=$slot"
[ -n "${IPP_OUTPUT_BIN:-}" ] && opt="$opt OutputBin=$IPP_OUTPUT_BIN"
# 白黒かグレースケールか(URF のときだけ効く。PWG Raster は 1bit で届く)
# メディアタイプで選ぶ: 写真(photographic)ならグレースケール、それ以外は白黒。
# print-color-mode は使えない。Mac も iPhone もモノクロのプリンタには切り替えを
# 出さず、常に monochrome を送ってくる(カラー対応と偽っても、iPhone は初期状態で
# 何も送らず、区別がつかない)。メディアタイプは Mac(写真用紙/便箋)にも
# iPhone(写真/普通紙)にも出る。
mtype="${IPP_MEDIA_TYPE:-}"
if [ -z "$mtype" ]; then
  mtype=$(printf '%s' "${IPP_MEDIA_COL:-}" | sed -n 's/.*media-type=\([a-z0-9-]*\).*/\1/p')
fi
case "$mtype" in
  photographic*) color=gray ;;
  *)             color="${MI700_COLOR:-bilevel}" ;;   # 既定を変えたいときだけ使う
esac
[ "${IPP_PRINT_COLOR_MODE:-}" = bi-level ] && color=bilevel
case "$color" in
  gray|bilevel) ;;
  *) echo "WARNING: MI700_COLOR=$color は不明です。白黒で印刷します" >&2; color=bilevel ;;
esac
opt="$opt MI700Color=$color"
# 印刷品質。IPP の3段階に4通りを割り当てる(片方向ドラフトは選べない)
case "${IPP_PRINT_QUALITY:-}" in
  draft)  opt="$opt OutputMode=draft-bi" ;;
  high)   opt="$opt OutputMode=std-uni" ;;
  normal) opt="$opt OutputMode=std-bi" ;;
esac

echo "DEBUG: $CONTENT_TYPE media-col=${IPP_MEDIA_COL:-} ->$opt" >&2
exec "$FILTER" 1 "${IPP_JOB_ORIGINATING_USER_NAME:-${USER:-me}}" \
     "${IPP_JOB_NAME:-job}" 1 "$opt" "$SRC"
